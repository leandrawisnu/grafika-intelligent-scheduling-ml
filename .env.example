# Server
ML_PORT=8000

# LLM (wajib diisi untuk fitur AI nyata)
OPENAI_API_KEY=CHANGE_ME_openai_api_key
LLM_MODEL=gpt-4o-mini

# Backend GIS (opsional, untuk callback ke API)
BACKEND_URL=http://127.0.0.1:8080

# AI Import dokumen (ingest) — parsing universal + pemetaan ke master GIS.
# LLAMA_CLOUD_API_KEY dari cloud.llamaindex.ai (LlamaParse).
LLAMA_CLOUD_API_KEY=CHANGE_ME_llama_cloud_api_key
# Tier parse: fast | cost_effective | agentic | agentic_plus
LLAMA_PARSE_TIER=agentic
LLAMA_PARSE_TIMEOUT_SECONDS=300
LLAMA_OCR_LANGUAGES=id,en

# OpenRouter untuk model pemetaan (default Gemini 2.5 Flash).
OPENROUTER_API_KEY=CHANGE_ME_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
INGEST_MODEL=google/gemini-2.5-flash
INGEST_TIMEOUT_SECONDS=180
INGEST_MAX_OUTPUT_TOKENS=60000
INGEST_MAX_TEKS=400000
